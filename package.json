{
	"name": "rc-coach",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"serve:ssr:rc-coach": "node dist/rc-coach/server/server.mjs",
		"preview": "pnpm run build && wrangler dev",
		"dev:api": "wrangler dev src/server.local-api.ts --assets public --port 8787 --show-interactive-dev-session=false",
		"deploy": "pnpm run build && wrangler deploy",
		"agent": "tsx .sandcastle/main.mts",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply TRACKS_DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply TRACKS_DB --remote"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"packageManager": "pnpm@10.23.0",
	"dependencies": {
		"@angular/common": "^21.0.0",
		"@angular/compiler": "^21.2.17",
		"@angular/core": "^21.2.4",
		"@angular/forms": "^21.0.0",
		"@angular/platform-browser": "^21.0.0",
		"@angular/platform-server": "^21.0.0",
		"@angular/router": "^21.0.0",
		"@angular/ssr": "^21.2.3",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.18",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "^0.5.8",
		"@angular/build": "^21.0.1",
		"@angular/cli": "^21.0.1",
		"@angular/compiler-cli": "^21.0.0",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/node": "^20.17.19",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^27.1.0",
		"postcss": "^8.5.3",
		"tailwindcss": "^4.1.12",
		"tsx": "^4.21.0",
		"typescript": "~5.9.2",
		"vitest": "^4.0.8",
		"wrangler": "^4.59.1",
		"xhr2": "^0.2.1"
	}
}
